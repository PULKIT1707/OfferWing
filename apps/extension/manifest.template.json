{
  "manifest_version": 3,
  "name": "Offerwing",
  "version": "0.1.0",
  "description": "Your AI job-search copilot: fit scores and referrals on LinkedIn, and application forms filled for you to review. You always submit.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Offerwing", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "__APP_PATTERN__",
    "__SUPABASE_PATTERN__",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "externally_connectable": { "matches": ["__APP_PATTERN__"] }
}
