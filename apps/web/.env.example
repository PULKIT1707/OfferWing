NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Lets agents decrypt a user's Always-on AI key (Supabase → Project Settings → API keys → secret key).
SUPABASE_SERVICE_ROLE_KEY=

# Offerwing's own Anthropic key that powers Starter mode (2 profile audits per user per day).
OFFERWING_STARTER_ANTHROPIC_API_KEY=

# Optional model overrides per provider and tier, e.g. OFFERWING_OPENAI_MODEL_PREMIUM=gpt-5
# Tiers: PREMIUM (audits, strategy), STANDARD (drafts), FAST (extraction, scoring).

# ID of the Offerwing browser extension allowed to receive the user's session on /extension/connect.
# The dev build's ID is fixed by the "key" in apps/extension/manifest.template.json.
NEXT_PUBLIC_EXTENSION_ID=mgoonaiikahlemfjhcdgpdgjmkjjbmbc

# Job-alert forwarding: the inbound-email provider POSTs to /api/inbound/email?secret=<this>.
INBOUND_EMAIL_SECRET=
# Domain of users' alert addresses (<alias>@<domain>). Default: alerts.offerwing.ai
ALERT_EMAIL_DOMAIN=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
